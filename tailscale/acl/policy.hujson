{
	// Named tailnet/LAN addresses (stable Tailscale IPs; swag = a LAN IP on
	// discovery's advertised subnet, where *.homelab.pastelariadev.com resolves).
	"hosts": {
		"laptop":     "100.74.137.124",
		"endeavour":  "100.107.225.13",
		"pathfinder": "100.102.248.13",
		"discovery":  "100.76.140.121",
		"swag":       "192.168.10.210",
		"nanokvm":   "100.125.209.99",
		"kepler":     "100.94.239.46",
		"orion":      "100.72.85.73",
		"archinaut":  "100.67.123.113",
		"voyager":    "100.105.38.10",
		"vanguard":   "100.90.247.79",
		"gemini":     "100.91.131.59",
		"galaxy-s25": "100.66.253.15",
	},

	// Auto-approve discovery's advertised routes (the node is owned by this
	// account), so they take effect on apply without a manual approval click.
	// Narrowed from 192.168.10.0/24 to /32s: a broad subnet route poisons
	// on-LAN hosts that also run --accept-routes (orion/kepler) — they pull
	// their own subnet into Tailscale's table 52 and blackhole the LAN. Only
	// the LAN-only devices that genuinely need tailnet reach are approved:
	// swag ingress (.210), UDM (.1), swOS switch (.2).
	"autoApprovers": {
		"routes": {
			"192.168.10.210/32": ["erikbogado@gmail.com"],
			"192.168.10.1/32":   ["erikbogado@gmail.com"],
			"192.168.10.2/32":   ["erikbogado@gmail.com"],
			"192.168.10.4/32": ["erikbogado@gmail.com"],
		},
	},

	// Tag ownership. tag:server lets the fleet enroll via a non-expiring OAuth
	// client secret (scope auth_keys, tag:server) instead of a 90-day auth key —
	// a device advertising tag:server is owned by the tag, and the account owns
	// the tag here so it can mint/rotate keys for it. Applied first for voyager.
	"tagOwners": {
		"tag:server": ["erikbogado@gmail.com"],
	},

	"acls": [
		// 1. Admin devices: OpenSSH (port 2222) into everything.
		{"action": "accept", "src": ["laptop", "endeavour", "pathfinder"], "dst": ["*:2222"]},

		// Galaxy mobile pilot: OpenSSH only to its named endpoints.
		{"action": "accept", "src": ["galaxy-s25"], "dst": ["gemini:2222", "endeavour:2222", "orion:2222"]},

		// Endeavour fallback: direct SWAG access when another overlay shadows the
		// routed 192.168.10.210/32 path.
		{"action": "accept", "src": ["endeavour"], "dst": ["discovery:80,443"]},

		// 2. Everyone: DNS to discovery (MagicDNS nameserver / AdGuard) and to
		//    vanguard's secondary CoreDNS resolver (R1, services.fleetDns) — the
		//    offsite fallback in the global nameserver list, so fleet-name
		//    resolution survives discovery being down.
		{"action": "accept", "src": ["*"], "dst": ["discovery:53", "swag:53", "vanguard:53"]},

		// 3. Everyone: the SWAG ingress only. All services are published as
		//    *.homelab.pastelariadev.com -> swag, which reverse-proxies them.
		{"action": "accept", "src": ["*"], "dst": ["swag:80,443"]},

		// 4. discovery is the hub (SWAG reverse-proxy, LiteLLM router, monitoring,
		//    DNS) — it reaches every host on every port.
		{"action": "accept", "src": ["discovery"], "dst": ["*:*"]},

		// 5. Preserved: Syncthing between fleet hosts.
		{
			"action": "accept",
			"src":    ["laptop", "endeavour", "pathfinder", "kepler", "orion", "discovery"],
			"dst":    ["laptop:22000", "endeavour:22000", "pathfinder:22000", "kepler:22000", "orion:22000", "discovery:22000"],
		},
		// Gemini syncs only with the replacement workstation carrying the laptop
		// Syncthing identity. Allow either peer to initiate the stateful connection.
		{"action": "accept", "src": ["endeavour"], "dst": ["gemini:22000"]},
		{"action": "accept", "src": ["gemini"], "dst": ["endeavour:22000"]},

		// 6. Preserved: NFS / SMB to the kepler NAS from fleet hosts.
		{
			"action": "accept",
			"src":    ["laptop", "endeavour", "pathfinder", "orion", "discovery"],
			"dst":    ["kepler:111,445,2049,4000,4001,4002"],
		},

		// 7. Fleet Alloy -> discovery's observability sinks: Loki :3100 (logs) +
		//    Prometheus remote_write :9090 (metrics). Every host's Alloy pushes
		//    here; k3s in-cluster Alloy egresses SNAT'd to kepler's TS IP too.
		//    archinaut ships journal logs via vector (lite alloy; the 1 GB Pi
		//    can't run full alloy) — logs-only, but the bundled :9090 grant is
		//    harmless.
		{"action": "accept", "src": ["laptop", "endeavour", "pathfinder", "orion", "kepler", "archinaut"], "dst": ["discovery:3100,9090"]},

		// Public SSH hosts use the lightweight Vector shipper. Logs-only:
		// neither host needs Prometheus or broader observability access.
		{"action": "accept", "src": ["voyager", "vanguard"], "dst": ["discovery:3100"]},

		// 8. Admin devices reach the whole LAN through discovery's subnet route,
		//    so tailnet devices can hit LAN-only hosts (swOS switches, UDM,
		//    printer, IoT) that can't run Tailscale. Admin-only preserves the
		//    posture — other tailnet devices still get only SWAG (rule 3). SNAT
		//    on the router means no return route is needed on the UDM.
		{"action": "accept", "src": ["laptop", "endeavour", "pathfinder"], "dst": ["192.168.10.0/24:*"]},

		// NanoKVM is an administrative trust boundary. Keep direct web and SSH
		// access limited to the same three admin devices.
		{"action": "accept", "src": ["laptop", "endeavour", "pathfinder"], "dst": ["nanokvm:22,443"]},

		// 9. Fleet pulls from orion's nix binary cache (nix-serve :5000) over
		//    MagicDNS (http://orion:5000, see desktop-nixos common.nix). The LAN
		//    path works via rule 8's subnet route, but non-admin hosts and the
		//    MagicDNS name need this explicit grant or the substituter times out.
		{"action": "accept", "src": ["laptop", "endeavour", "pathfinder", "kepler"], "dst": ["orion:5000"]},

		// 10. Lab ESO (kepler) -> the platform OpenBao on discovery :8200 (P3.1b).
		//    External Secrets in the kepler lab cluster repoints off the disposable
		//    in-cluster vault to the always-on OpenBao on discovery. In-cluster ESO
		//    pods egress SNAT'd to kepler's tailnet IP, so src "kepler" covers them
		//    (same path rule 7's in-cluster Alloy uses). Blast radius = lab only.
		{"action": "accept", "src": ["kepler"], "dst": ["discovery:8200"]},

		// 11. Kepler sends its config backup to voyager's append-only Restic
		//     receiver. No other voyager service is exposed to Kepler.
		{"action": "accept", "src": ["kepler"], "dst": ["voyager:8000"]},

		// 12. Any fleet host -> orion's shared sccache WebDAV cache (:4321, nginx
		//    dav). Routes dev-loop `cargo build` artifacts to orion; a miss or an
		//    unreachable orion falls back to a local compile (desktop-nixos
		//    modules/services/sccache.nix). Broad src so servers can share the
		//    cache too; actual use is opt-in per host (sccacheClient.enable).
		{"action": "accept", "src": ["*"], "dst": ["orion:4321"]},

		// 14. vanguard's Postgres DR replica (R3b) streams from discovery's
		//     shared cluster over the tailnet. discovery publishes :5432 on its
		//     tailnet IP (servarr infra stack), gated to vanguard alone here.
		{"action": "accept", "src": ["vanguard"], "dst": ["discovery:5432"]},

		// 15. gemini dev sandbox -> discovery's Prometheus :9090 (read path). The
		//     grafatui TUI (`fleet-metrics`) in the dev container queries fleet
		//     metrics from discovery. gemini is a tag:server node (own tailnet
		//     identity); a dedicated grant keeps rule 7's Alloy-push semantics
		//     clean and avoids handing gemini the bundled Loki :3100 it never uses.
		{"action": "accept", "src": ["gemini"], "dst": ["discovery:9090"]},

		// 16. gemini dev sandbox -> orion host SSH (:2222). The container's RO
		//     store can't build new derivations, so `nix build`/dev loops run on
		//     the orion host; this also makes `ssh orion` resolve by MagicDNS from
		//     inside the container. Scoped to orion alone — the sandbox is not an
		//     admin device (rule 1), so it gets no fleet-wide :2222.
		{"action": "accept", "src": ["gemini"], "dst": ["orion:2222"]},
	],

	// Hosts use OpenSSH on :2222 (governed by the acls above); Tailscale SSH is
	// not enabled, so no "ssh" section. Add one (needs tags) if you ever turn on
	// `tailscale up --ssh`.

	"tests": [
		{"src": "laptop", "accept": ["kepler:2222"]},    // admin can SSH
		{"src": "endeavour", "accept": ["kepler:2222", "kepler:2049", "orion:2222", "orion:4321"]}, // replacement workstation
		{"src": "endeavour", "accept": ["discovery:80", "discovery:443"]}, // admin reaches SWAG directly over Tailscale
		{"src": "orion", "deny": ["discovery:80", "discovery:443"]}, // non-admin cannot bypass routed SWAG ingress
		{"src": "orion", "deny": ["kepler:2222"]},       // non-admin cannot SSH
		{"src": "orion", "deny": ["kepler:8001"]},       // no direct backend access
		{"src": "discovery", "accept": ["kepler:6443"]}, // hub reaches k3s
		{"src": "discovery", "accept": ["orion:8080"]},  // hub reaches host services (LLMs)
		{"src": "kepler", "accept": ["discovery:3100"]}, // cluster ships logs to Loki
		{"src": "voyager", "accept": ["discovery:3100"]}, // public host ships SSH journals
		{"src": "vanguard", "accept": ["discovery:3100"]}, // public host ships SSH journals
		{"src": "kepler", "accept": ["discovery:8200"]}, // lab ESO reads OpenBao
		{"src": "kepler", "accept": ["voyager:8000"]},   // offsite Restic backup
		{"src": "orion", "accept": ["discovery:9090"]},  // host Alloy ships metrics
		{"src": "orion", "accept": ["kepler:2049"]},     // NFS preserved
		{"src": "kepler", "accept": ["orion:22000"]},    // syncthing preserved
		{"src": "kepler", "accept": ["orion:5000"]},     // fleet pulls orion nix cache
		{"src": "laptop", "accept": ["orion:4321"]},     // workstation reaches sccache cache
		{"src": "kepler", "accept": ["orion:4321"]},     // servers may share the sccache cache too
		{"src": "orion", "accept": ["vanguard:53"]},     // fleet reaches vanguard's secondary resolver
		{"src": "vanguard", "accept": ["discovery:5432"]}, // DR replica streams from discovery Postgres
		{"src": "orion", "deny": ["discovery:5432"]},      // only vanguard reaches the DB, not other peers
		{"src": "gemini", "accept": ["discovery:9090"]},   // grafatui reads fleet metrics
		{"src": "gemini", "deny": ["discovery:3100"]},     // dev sandbox has no Loki grant
		{"src": "gemini", "accept": ["orion:2222"]},       // build-on-host SSH from the sandbox
		{"src": "gemini", "deny": ["kepler:2222"]},        // but not admin SSH into the rest of the fleet
		{"src": "endeavour", "accept": ["gemini:22000"]}, // replacement workstation syncs Gemini
		{"src": "gemini", "accept": ["endeavour:22000"]}, // Gemini may initiate the same sync
		{"src": "galaxy-s25", "accept": ["gemini:2222", "endeavour:2222", "orion:2222"]}, // mobile reaches only its named endpoints
		{"src": "galaxy-s25", "deny": ["laptop:2222", "pathfinder:2222", "discovery:2222", "kepler:2222", "archinaut:2222", "voyager:2222", "vanguard:2222"]}, // no other fleet-admin SSH
		{"src": "endeavour", "accept": ["voyager:2222", "vanguard:2222"]}, // admin reaches public hosts through Tailscale
		{"src": "orion", "deny": ["voyager:2222", "vanguard:2222"]},       // ordinary servers cannot administer them
		{"src": "laptop", "accept": ["192.168.10.1:443"]}, // admin reaches the UDM via the route
		{"src": "orion", "deny": ["192.168.10.2:80"]},     // non-admin can't reach LAN-only hosts
		{"src": "laptop", "accept": ["nanokvm:22", "nanokvm:443"]}, // admin reaches NanoKVM
		{"src": "orion", "deny": ["nanokvm:22", "nanokvm:443"]},    // non-admin cannot reach NanoKVM
	],
}
